[Unit]
Description=Trident mieru server
After=network-online.target

[Service]
Type=simple
User=trident
Group=trident
Environment=MITA_CONFIG_JSON_FILE=/var/lib/trident-agent/current/mita.json
ExecStart=/usr/local/bin/mita run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
