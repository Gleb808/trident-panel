[Unit]
Description=Trident access control panel
After=network.target

[Service]
Type=simple
User=trident
Group=trident
WorkingDirectory=/opt/trident-panel
Environment=DATA_DIR=/var/lib/trident
Environment=AGENT_STATE=/var/lib/trident-agent/state.json
Environment=PORT=8787
ExecStart=/opt/trident-panel/runtime/node /opt/trident-panel/src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trident
UMask=0077

[Install]
WantedBy=multi-user.target
