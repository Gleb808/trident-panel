[Unit]
Description=Trident VLESS REALITY
After=network-online.target

[Service]
Type=simple
User=trident
Group=trident
ExecStart=/usr/local/bin/xray run -config /var/lib/trident-agent/current/xray.json
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
