[Unit]
Description=Trident NaiveProxy and HTTPS panel gateway
After=network-online.target

[Service]
Type=simple
User=trident
Group=trident
Environment=HOME=/var/lib/trident-caddy
ExecStart=/usr/local/bin/caddy run --config /var/lib/trident-agent/current/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trident-caddy

[Install]
WantedBy=multi-user.target
